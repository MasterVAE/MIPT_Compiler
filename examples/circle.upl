a = 10;
b = 10;


sq(n)
{
    return(n * n);
};

circle(n, m)
{
    while(a < n)
    {
        b = 0;
        while(b < m)
        {
            if(sq(a - 5) + sq(b - 5) < 21)
            {
                set(a, b);
            };
            b = b + 1;
        };

        a = a + 1;
    };

    draw;
};


circle(a, b);